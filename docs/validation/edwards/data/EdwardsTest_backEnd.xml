<function name="library.Media.SimpleFluid.region_ph">
<ModelicaImplementation>function(p :: Real * h :: Real) =&gt; Integerlibrary.Media.SimpleFluid.region_phfunction library.Media.SimpleFluid.region_ph &quot;Region flag: 1=liquid, 2=steam, 4=two-phase&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  input Real h &quot;Specific enthalpy [J/kg]&quot;;
  output Integer region;
algorithm
  if h &lt; library.Media.SimpleFluid.h_f(p) then
    region := 1;
  elseif h &gt; library.Media.SimpleFluid.h_g(p) then
    region := 2;
  else
    region := 4;
  end if;
end library.Media.SimpleFluid.region_ph;


</ModelicaImplementation>
