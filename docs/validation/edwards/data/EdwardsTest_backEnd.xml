<equations dimension="45">
<equation id="1">pipe.rho_face[6] * pipe.V_cell * der(pipe.h[5]) = pipe.mdot[5] * (pipe.h_face[5] - pipe.h[5]) + pipe.mdot[6] * (pipe.h[5] - pipe.h_face[6]) + pipe.V_cell * der(pipe.p[5]) + pipe.q_wall[5]
</equation>
<equation id="2">pipe.rho[4] * pipe.V_cell * der(pipe.h[4]) = pipe.mdot[4] * (pipe.h_face[4] - pipe.h[4]) + pipe.mdot[5] * (pipe.h[4] - pipe.h_face[5]) + pipe.V_cell * der(pipe.p[4]) + pipe.q_wall[4]
</equation>
<equation id="3">pipe.rho[3] * pipe.V_cell * der(pipe.h[3]) = pipe.mdot[3] * (pipe.h_face[3] - pipe.h[3]) + pipe.mdot[4] * (pipe.h[3] - pipe.h_face[4]) + pipe.V_cell * der(pipe.p[3]) + pipe.q_wall[3]
</equation>
<equation id="4">pipe.rho[2] * pipe.V_cell * der(pipe.h[2]) = pipe.mdot[2] * (pipe.h_face[2] - pipe.h[2]) + pipe.mdot[3] * (pipe.h[2] - pipe.h_face[3]) + pipe.V_cell * der(pipe.p[2]) + pipe.q_wall[2]
</equation>
<equation id="5">pipe.rho_face[1] * pipe.V_cell * der(pipe.h[1]) = pipe.mdot[2] * (pipe.h[1] - pipe.h_face[2]) + pipe.V_cell * der(pipe.p[1]) + pipe.q_wall[1]
</equation>
<equation id="6">der(pipe.mdot[6]) = (pipe.A_flow * (pipe.p[5] - atm.p_set) + (-0.5) * pipe.f_D * pipe.dx * abs(pipe.mdot[6]) * pipe.mdot[6] / (pipe.A_flow ^ 2.0 * pipe.D_h * pipe.rho_face[6])) * pipe.A_flow / (pipe.rho_face[6] * pipe.dx)
</equation>
<equation id="7">der(pipe.mdot[5]) = (pipe.A_flow * (pipe.p[4] - pipe.p[5]) + (-0.5) * pipe.f_D * pipe.dx * abs(pipe.mdot[5]) * pipe.mdot[5] / (pipe.A_flow ^ 2.0 * pipe.rho_face[5]) / pipe.D_h) * pipe.A_flow / (pipe.rho_face[5] * pipe.dx)
</equation>
<equation id="8">der(pipe.mdot[4]) = (pipe.A_flow * (pipe.p[3] - pipe.p[4]) + (-0.5) * pipe.f_D * pipe.dx * abs(pipe.mdot[4]) * pipe.mdot[4] / (pipe.A_flow ^ 2.0 * pipe.rho_face[4]) / pipe.D_h) * pipe.A_flow / (pipe.rho_face[4] * pipe.dx)
</equation>
<equation id="9">der(pipe.mdot[3]) = (pipe.A_flow * (pipe.p[2] - pipe.p[3]) + (-0.5) * pipe.f_D * pipe.dx * abs(pipe.mdot[3]) * pipe.mdot[3] / (pipe.A_flow ^ 2.0 * pipe.rho_face[3]) / pipe.D_h) * pipe.A_flow / (pipe.rho_face[3] * pipe.dx)
</equation>
<equation id="10">der(pipe.mdot[2]) = (pipe.A_flow * (pipe.p[1] - pipe.p[2]) + (-0.5) * pipe.f_D * pipe.dx * abs(pipe.mdot[2]) * pipe.mdot[2] / (pipe.A_flow ^ 2.0 * pipe.rho_face[2]) / pipe.D_h) * pipe.A_flow / (pipe.rho_face[2] * pipe.dx)
</equation>
<equation id="11">closed_end.port.p = pipe.p[1]
</equation>
<equation id="12">pipe.V_cell * (pipe.drho_dp[5] * der(pipe.p[5]) + pipe.drho_dh[5] * der(pipe.h[5])) = pipe.mdot[5] - pipe.mdot[6]
</equation>
<equation id="13">pipe.V_cell * (pipe.drho_dp[4] * der(pipe.p[4]) + pipe.drho_dh[4] * der(pipe.h[4])) = pipe.mdot[4] - pipe.mdot[5]
</equation>
<equation id="14">pipe.V_cell * (pipe.drho_dp[3] * der(pipe.p[3]) + pipe.drho_dh[3] * der(pipe.h[3])) = pipe.mdot[3] - pipe.mdot[4]
</equation>
<equation id="15">pipe.V_cell * (pipe.drho_dp[2] * der(pipe.p[2]) + pipe.drho_dh[2] * der(pipe.h[2])) = pipe.mdot[2] - pipe.mdot[3]
</equation>
