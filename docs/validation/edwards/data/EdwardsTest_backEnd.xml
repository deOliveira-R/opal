<function name="library.Media.SimpleFluid.T_ph">
<ModelicaImplementation>function(p :: Real * h :: Real) =&gt; Reallibrary.Media.SimpleFluid.T_phfunction library.Media.SimpleFluid.T_ph &quot;Temperature [K] from (p, h)&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  input Real h &quot;Specific enthalpy [J/kg]&quot;;
  output Real T_val;
  protected Integer reg = library.Media.SimpleFluid.region_ph(p, h);
algorithm
  if reg == 1 then
    T_val := library.Media.SimpleFluid.T_sat(p) - (library.Media.SimpleFluid.h_f(p) - h) / 4000.0;
  elseif reg == 2 then
    T_val := library.Media.SimpleFluid.T_sat(p) + (h - library.Media.SimpleFluid.h_g(p)) / 2000.0;
  else
    T_val := library.Media.SimpleFluid.T_sat(p);
  end if;
end library.Media.SimpleFluid.T_ph;


</ModelicaImplementation>
</function>
<function name="library.Media.SimpleFluid.T_sat">
<ModelicaImplementation>function(p :: Real) =&gt; Reallibrary.Media.SimpleFluid.T_satfunction library.Media.SimpleFluid.T_sat &quot;Saturation temperature [K]&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  output Real T_val;
algorithm
  T_val := 400.0 + 20.0 * (p - 1e7) / 1e7;
end library.Media.SimpleFluid.T_sat;


</ModelicaImplementation>
</function>
<function name="library.Media.SimpleFluid.drho_dh_p">
<ModelicaImplementation>function(p :: Real * h :: Real) =&gt; Reallibrary.Media.SimpleFluid.drho_dh_pfunction library.Media.SimpleFluid.drho_dh_p &quot;Partial derivative drho/dh at constant p [kg/(m^3 * J/kg)]&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  input Real h &quot;Specific enthalpy [J/kg]&quot;;
  output Real val;
  protected Integer reg = library.Media.SimpleFluid.region_ph(p, h);
  protected Real rf;
  protected Real rg;
  protected Real hfgv;
  protected Real rho_mix;
algorithm
  if reg == 1 then
    val := -6.25e-5;
  elseif reg == 2 then
    val := -2e-5;
  else
    rf := library.Media.SimpleFluid.rho_f(p);
    rg := library.Media.SimpleFluid.rho_g(p);
    hfgv := library.Media.SimpleFluid.h_fg(p);
    rho_mix := library.Media.SimpleFluid.rho_ph_2phase(p, h);
    val := -rho_mix * rho_mix * (1.0 / rg - 1.0 / rf) / hfgv;
  end if;
end library.Media.SimpleFluid.drho_dh_p;


</ModelicaImplementation>
</function>
<function name="library.Media.SimpleFluid.drho_dp_h">
<ModelicaImplementation>function(p :: Real * h :: Real) =&gt; Reallibrary.Media.SimpleFluid.drho_dp_hfunction library.Media.SimpleFluid.drho_dp_h &quot;Partial derivative drho/dp at constant h [kg/(m^3*Pa)]&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  input Real h &quot;Specific enthalpy [J/kg]&quot;;
  output Real val;
  protected Integer reg = library.Media.SimpleFluid.region_ph(p, h);
  protected Real rf;
  protected Real rg;
  protected Real hfv;
  protected Real hgv;
  protected Real hfgv;
  protected Real x;
  protected Real vf;
  protected Real vg;
  protected Real v;
  protected Real rho2;
  protected Real drf_dp;
  protected Real drg_dp;
  protected Real dhf_dp;
  protected Real dhg_dp;
  protected Real dhfg_dp;
  protected Real dvf_dp;
  protected Real dvg_dp;
  protected Real dx_dp;
  protected Real dv_dp;
algorithm
  if reg == 1 then
    val := 2.625e-6;
  elseif reg == 2 then
    val := 6e-7;
  else
    rf := library.Media.SimpleFluid.rho_f(p);
    rg := library.Media.SimpleFluid.rho_g(p);
    hfv := library.Media.SimpleFluid.h_f(p);
    hgv := library.Media.SimpleFluid.h_g(p);
    hfgv := hgv - hfv;
    x := (h - hfv) / hfgv;
    vf := 1.0 / rf;
    vg := 1.0 / rg;
    v := x * vg + (1.0 - x) * vf;
    rho2 := 1.0 / (v * v);
    drf_dp := 2e-6;
    drg_dp := 5e-7;
    dhf_dp := 0.01;
    dhg_dp := 0.005;
    dhfg_dp := dhg_dp - dhf_dp;
    dvf_dp := -drf_dp / (rf * rf);
    dvg_dp := -drg_dp / (rg * rg);
    dx_dp := (dhf_dp + x * dhfg_dp) / (-hfgv);
    dv_dp := dx_dp * (vg - vf) + x * dvg_dp + (1.0 - x) * dvf_dp;
    val := -rho2 * dv_dp;
  end if;
end library.Media.SimpleFluid.drho_dp_h;


</ModelicaImplementation>
</function>
