<function name="library.Media.SimpleFluid.quality_ph">
<ModelicaImplementation>function(p :: Real * h :: Real) =&gt; Reallibrary.Media.SimpleFluid.quality_phfunction library.Media.SimpleFluid.quality_ph &quot;Steam quality x from (p, h)&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  input Real h &quot;Specific enthalpy [J/kg]&quot;;
  output Real x_val;
algorithm
  x_val := (h - library.Media.SimpleFluid.h_f(p)) / library.Media.SimpleFluid.h_fg(p);
