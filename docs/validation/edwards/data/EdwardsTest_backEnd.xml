<function name="library.Media.SimpleFluid.rho_ph">
<ModelicaImplementation>function(p :: Real * h :: Real) =&gt; Reallibrary.Media.SimpleFluid.rho_phfunction library.Media.SimpleFluid.rho_ph &quot;Density [kg/m^3] from (p, h)&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  input Real h &quot;Specific enthalpy [J/kg]&quot;;
  output Real rho_val;
  protected Integer reg = library.Media.SimpleFluid.region_ph(p, h);
algorithm
  if reg == 1 then
    rho_val := library.Media.SimpleFluid.rho_f(p) + 6.25e-5 * (library.Media.SimpleFluid.h_f(p) - h);
  elseif reg == 2 then
    rho_val := library.Media.SimpleFluid.rho_g(p) - 2e-5 * (h - library.Media.SimpleFluid.h_g(p));
  else
    rho_val := library.Media.SimpleFluid.rho_ph_2phase(p, h);
  end if;
end library.Media.SimpleFluid.rho_ph;


</ModelicaImplementation>
</function>
<function name="library.Media.SimpleFluid.rho_ph_2phase">
<ModelicaImplementation>function(p :: Real * h :: Real) =&gt; Reallibrary.Media.SimpleFluid.rho_ph_2phasefunction library.Media.SimpleFluid.rho_ph_2phase &quot;Two-phase mixture density [kg/m^3]&quot;
  input Real p &quot;Pressure [Pa]&quot;;
  input Real h &quot;Specific enthalpy [J/kg]&quot;;
  output Real rho_val;
  protected Real x = library.Media.SimpleFluid.quality_ph(p, h);
  protected Real rf = library.Media.SimpleFluid.rho_f(p);
  protected Real rg = library.Media.SimpleFluid.rho_g(p);
algorithm
  rho_val := 1.0 / (x / rg + (1.0 - x) / rf);
end library.Media.SimpleFluid.rho_ph_2phase;


</ModelicaImplementation>
