package library "OPAL Modelica Component Library"
  annotation(Documentation(info="<html>
<p>Open Platform for Analytical Thermalhydraulics — Modelica component library.</p>
<p>Subpackages:</p>
<ul>
<li><b>Connectors</b> — FluidPort (pressure, flow, stream enthalpy)</li>
<li><b>Media</b> — IAPWS-IF97 + SimpleFluid property packages</li>
<li><b>Pipes</b> — 1D pipe components (staggered mesh, semi-implicit)</li>
<li><b>Boundary</b> — Pressure source, closed end, flow source</li>
</ul>
</html>"));
end library;
